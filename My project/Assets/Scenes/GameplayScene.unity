  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1914548800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.12, g: 0.12, b: 0.12, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: db6a0d05bde73494699e83919a89d63a, type: 3}
    m_FontSize: 17
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.15
  m_Text: "<b>TABLAS DE VERDAD Y LEYES L\xD3GICAS</b>\n\n<b>\u2713 5 TAUTOLOG\xCDAS (Siempre Verdaderas \u22A4):</b>\n1. <b>p \u2228 ~p</b> : \"O llueve o no llueve\" (Tercero excluido)\n2. <b>p \u2192 p</b> : \"Si hay stock, entonces hay stock\" (Identidad)\n3. <b>~(p \u2227 ~p)</b> : \"No ocurre que llueva y no llueva a la vez\"\n4. <b>(p \u2227 q) \u2192 p</b> : \"Si llueve y hace fr\xEDo, seguro llueve\"\n5. <b>p \u2192 (q \u2192 p)</b> : \"Si llueve, si hace fr\xEDo sigue lloviendo\"\n\n<b>\u2717 5 CONTRADICCIONES (Siempre Falsas \u22A5):</b>\n1. <b>p \u2227 ~p</b> : \"Llueve y no llueve al mismo tiempo\"\n2. <b>~(p \u2228 ~p)</b> : \"No es cierto que o llueva o no llueva\"\n3. <b>p \u2194 ~p</b> : \"Llueve si y solo si no llueve\" (Opuestos)\n4. <b>(p \u2192 q) \u2227 (p \u2227 ~q)</b> : \"Si llueve hace fr\xEDo, pero no\"\n5. <b>~(p \u2192 p)</b> : \"Es falso que si hay stock, haya stock\""
